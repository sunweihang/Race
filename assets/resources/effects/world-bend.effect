CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: bend-vs
      frag: bend-fs
      properties: &props
        tilingOffset:   { value: [1.0, 1.0, 0.0, 0.0] }
        mainColor:      { value: [1.0, 1.0, 1.0, 1.0], target: albedo, linear: true, editor: { type: color } }
        albedoScale:    { value: [1.0, 1.0, 1.0], target: albedoScaleAndCutoff.xyz }
        mainTexture:    { value: white, target: albedoMap }
        roughness:      { value: 0.8, target: pbrParams.y }
        metallic:       { value: 0.0, target: pbrParams.z }
        bendParams:     { value: [0.0, 0.0, 0.0, 750.0] }
  - name: glass
    passes:
    - vert: bend-vs
      frag: bend-fs
      properties: *props
      depthStencilState:
        depthTest: true
        depthWrite: true
      rasterizerState:
        cullMode: none
}%

CCProgram shared-ubos %{
  uniform Constants {
    vec4 tilingOffset;
    vec4 albedo;
    vec4 albedoScaleAndCutoff;
    vec4 pbrParams;
    vec4 bendParams;
  };
}%

CCProgram bend-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <shared-ubos>
  #include <legacy/fog-vs>
  #include <legacy/shadow-map-vs>

  out vec3 v_position;
  out vec3 v_normal;
  out vec2 v_uv;

  vec3 applySphereBend(vec3 worldPos) {
    vec3 cam = bendParams.xyz;
    float r = max(bendParams.w, 8.0);
    vec2 d = worldPos.xz - cam.xz;
    float dist = length(d);
    float theta = dist / r;
    if (dist > 0.0001) {
      vec2 dir = d / dist;
      worldPos.xz = cam.xz + dir * (r * sin(theta));
    }
    worldPos.y -= r * (1.0 - cos(theta));
    return worldPos;
  }

  void main () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    v_position = worldPos.xyz;
    v_normal = normalize((matWorldIT * vec4(In.normal, 0.0)).xyz);
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;

    vec4 bent = worldPos;
    bent.xyz = applySphereBend(worldPos.xyz);
    CC_TRANSFER_FOG(bent);
    CC_TRANSFER_SHADOW(bent);
    gl_Position = cc_matViewProj * bent;
  }
}%

CCProgram bend-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <shared-ubos>
  #include <legacy/fog-fs>
  #include <legacy/standard-surface-entry>

  in vec3 v_position;
  in vec3 v_normal;
  in vec2 v_uv;

#if USE_ALBEDO_MAP
  uniform sampler2D albedoMap;
#endif

  void surf (out StandardSurface s) {
    vec4 baseColor = albedo;
#if USE_ALBEDO_MAP
    vec4 texColor = texture(albedoMap, v_uv);
    texColor.rgb = SRGBToLinear(texColor.rgb);
    baseColor *= texColor;
#endif
    s.albedo = baseColor;
    s.albedo.rgb *= albedoScaleAndCutoff.xyz;
    s.normal = v_normal;
    s.position = v_position;
    s.occlusion = 1.0;
    s.roughness = pbrParams.y;
    s.metallic = pbrParams.z;
    s.specularIntensity = 0.5;
    s.emissive = vec3(0.0);
  }

  CC_STANDARD_SURFACE_ENTRY()
}%
